# ===== انسخ هذا الملف إلى .env محلياً، وفي Render أضفها كـ Environment Variables =====

# MongoDB Atlas (مجاني): https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/devstore

# سر توقيع JWT — أي نص عشوائي طويل
JWT_SECRET=change-this-to-a-long-random-string

# حساب الأدمن الافتراضي (يُنشأ تلقائياً عند أول تشغيل)
ADMIN_PHONE=770000000
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=المدير العام

# Cloudinary (مجاني): https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Telegram Bot: أنشئ بوت من @BotFather واحصل على التوكن
# ولمعرفة Chat ID: أرسل رسالة للبوت ثم افتح https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

PORT=3000
NODE_ENV=development
